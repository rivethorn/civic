#include <std/io>

int main() {
  int[] ages1 = [1, 2, 3, 4];
  assert(ages1[0] == 1);
  assert(ages1[3] == 4);
  ages1[1] = 20;
  assert(ages1[1] == 20);
  assert(ages1.size() == 4);
  assert(ages1.at(2) == 3);

  vec<int> ages2 = [10, 20, 30];
  assert(ages2[2] == 30);
  vec ages3 = [5, 6, 7];
  assert(ages3[0] == 5);

  ages3.insert(99);
  assert(ages3.size() == 4);
  assert(ages3[3] == 99);
  ages3[0] = 50;
  assert(ages3[0] == 50);
  ages3.insert(1, 42);
  assert(ages3.size() == 5);
  assert(ages3[1] == 42 && ages3[2] == 6 && ages3[4] == 99);

  map<string, int> ages4 = {
    "boy1": 20,
    "girl1": 22,
  };
  assert(ages4["boy1"] == 20);
  ages4["boy1"] = 24;
  assert(ages4["boy1"] == 24);
  ages4["boy2"] = 18;
  assert(ages4.size() == 3);
  assert(ages4.at("girl1") == 22);
  ages4.insert("girl2", 30);
  assert(ages4.at("girl2") == 30);
  assert(ages4["nobody"] == 0);

  int total = 0;
  for x in ages1 {
    total += x;
  }
  assert(total == 1 + 20 + 3 + 4);

  int vecTotal = 0;
  for v in ages2 {
    vecTotal += v;
  }
  assert(vecTotal == 10 + 20 + 30);

  int names = 0;
  for key in ages4 {
    names += 1;
  }
  assert(names == 4);

  println("collections ok: ages1 size=", ages1.size(), " boy1=", ages4["boy1"]);
  return 0;
}
