#include <std/io>
#include <std/math>
#include <std/numeric>
#include <std/algorithm>
#include <std/string>

int main() {
    assert(abs(-9) == 9);
    assert(min(12, 4) == 4);
    assert(max(12, 4) == 12);
    assert(clamp(20, 0, 10) == 10);
    assert(clamp(-4, 0, 10) == 0);
    assert(sign(-8) == -1);
    assert(sign(0) == 0);
    assert(is_even(42));
    assert(is_odd(41));
    assert(square(-4) == 16);
    assert(cube(-3) == -27);
    assert(is_between(5, 1, 7));
    assert(!is_between(8, 1, 7));
    assert(ceil_div(10, 3) == 4);
    assert(ceil_div(-10, 3) == -3);
    assert(ceil_div(10, -3) == -3);
    assert(ceil_div(-10, -3) == 4);

    assert(gcd(84, 30) == 6);
    assert(lcm(12, 18) == 36);
    assert(pow_int(3, 5) == 243);
    assert(pow_int(3, -1) == 0);
    assert(factorial(6) == 720);
    assert(triangular(10) == 55);
    assert(fibonacci(0) == 0);
    assert(fibonacci(10) == 55);
    assert(fibonacci(-1) == 0);
    assert(sqrt_int(0) == 0);
    assert(sqrt_int(15) == 3);
    assert(sqrt_int(16) == 4);
    assert(is_prime(2));
    assert(is_prime(97));
    assert(!is_prime(1));
    assert(!is_prime(91));
    assert(digit_sum(907) == 16);
    assert(digit_sum(-9) == 0);

    assert(sum_range(1, 6) == 15);
    assert(product_range(1, 5) == 24);
    assert(count_range(-3, 4) == 7);
    assert(sum_multiples(1, 11, 3) == 18);
    assert(count_if_even(-2, 5) == 4);
    assert(count_multiples(1, 11, 3) == 3);
    assert(contains_range(2, 5, 4));
    assert(!contains_range(2, 5, 5));
    assert(min_range(-3, 5) == -3);
    assert(max_range(-3, 5) == 4);
    assert(min_range(4, 4) == 0);
    assert(sum_range(8, 2) == 0);
    assert(product_range(8, 2) == 1);
    assert(sum_multiples(0, 10, 0) == 0);

    assert(length("Civic") == 5);
    assert(equals("library", "library"));
    assert(!equals("civic", "Civic"));
    assert(contains("standard library", "library"));
    assert(!contains("standard library", "missing"));
    assert(starts_with("civic compiler", "civic"));
    assert(!starts_with("civic compiler", "compiler"));
    assert(ends_with("civic compiler", "compiler"));
    assert(ends_with("civic compiler", ""));
    assert(!ends_with("civic", "compiler"));
    println("stdlib suite passed");
    return 0;
}
