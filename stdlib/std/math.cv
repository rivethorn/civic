#header math

int abs(int value) {
  if (value < 0) {
    return -value;
  }
  return value;
}

int min(int left, int right) {
  if (left < right) {
    return left;
  }
  return right;
}

int max(int left, int right) {
  if (left > right) {
    return left;
  }
  return right;
}

int clamp(int value, int lower, int upper) {
  if (lower > upper) {
    return lower;
  }
  if (value < lower) {
    return lower;
  }
  if (value > upper) {
    return upper;
  }
  return value;
}

int sign(int value) {
  if (value < 0) {
    return -1;
  }
  if (value > 0) {
    return 1;
  }
  return 0;
}

bool is_even(int value) {
  return value % 2 == 0;
}

bool is_odd(int value) {
  return value % 2 != 0;
}

int square(int value) {
  return value * value;
}

int cube(int value) {
  return value * value * value;
}

bool is_between(int value, int lower, int upper) {
  return value >= lower && value <= upper;
}

int ceil_div(int value, int divisor) {
  if (divisor == 0) {
    return 0;
  }
  int quotient = value / divisor;
  int remainder = value % divisor;
  if (remainder != 0 && ((value < 0) == (divisor < 0))) {
    quotient++;
  }
  return quotient;
}
