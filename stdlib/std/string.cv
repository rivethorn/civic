#header string

int __civic_string_length(string value);
bool __civic_string_equals(string left, string right);
bool __civic_string_contains(string value, string needle);
bool __civic_string_starts_with(string value, string prefix);
bool __civic_string_ends_with(string value, string suffix);

int length(string value) {
  return __civic_string_length(value);
}

bool equals(string left, string right) {
  return __civic_string_equals(left, right);
}

bool contains(string value, string needle) {
  return __civic_string_contains(value, needle);
}

bool starts_with(string value, string prefix) {
  return __civic_string_starts_with(value, prefix);
}

bool ends_with(string value, string suffix) {
  return __civic_string_ends_with(value, suffix);
}
